# ─── Python cache ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/
*.egg

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Jupyter ─────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Raw LinkedIn data ────────────────────────────────────────────────────────
# WARNING: Do NOT commit raw LinkedIn exports — this repo is public.
# They contain personal data, real email addresses, and profile URLs.
# (These were previously tracked at the project root and removed — see commit
# history. They are NOT purged from old commits; that is a separate, deliberate
# git-history rewrite decision, not done automatically here.)
/Connections.csv
/Connections
/connections.csv
/Company Follows.csv
/company_follows.csv
/Invitations.csv
/invitations.csv
data/raw/*.csv
data/raw/*.CSV

# ─── Weekly snapshot folders — raw LinkedIn exports, NEVER commit ────────────
# Root-anchored so this only matches dated snapshot folders created by
# src/weekly_snapshot_refresh.py (DD-MM or YYYY-MM-DD), not any similarly
# named directory that might legitimately exist elsewhere in the tree.
/[0-9][0-9]-[0-9][0-9]/
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# Local scratch/stash data (e.g. previous-snapshot baselines used only for
# computing weekly deltas) — never committed.
data/processed/*
!data/processed/.gitkeep

# Manual weekly action log (Action Plan Progress) — tracks activity that
# can't be measured from LinkedIn exports (comments, posts, career-site
# submissions, manual DMs). Private/local only, never committed.
data/manual/*
!data/manual/.gitkeep
data/manual/weekly_action_log.csv
data/manual/*.csv
weekly_action_log.csv

# Manual profile enrichment (Untapped Outreach Scoring V9) — private,
# manually-observed LinkedIn profile signals used only to boost never-
# contacted scoring. Already covered by data/manual/*.csv above; these
# extra patterns are defense in depth in case the file is ever moved.
data/manual/profile_enrichment.csv
profile_enrichment.csv
*profile_enrichment*.csv

# ─── Private message data — NEVER commit ──────────────────────────────────────
messages.csv
Messages.csv
*messages*.csv
data/raw/messages.csv
data/raw/Messages.csv

# ─── Processed / output data ─────────────────────────────────────────────────
# Uncomment the lines below if you do NOT want to commit output CSVs:
# outputs/*.csv
# reports/*.xlsx
# reports/*.md

# ─── Message-derived outputs — local/private, never committed ────────────────
# These are built from messages.csv (private, gitignored above). They used to
# carry a "sanitized_last_message_excerpt" column that only redacted email/
# phone patterns and still embedded real conversation text — that field has
# been removed from the generator, but these files stay untracked going
# forward as defense in depth (per the "no raw messages" rule).
outputs/message_threads_summary.csv
outputs/recruiter_conversation_history.csv
outputs/lead_reactivation_backlog.csv
outputs/lead_reactivation_this_week.csv
outputs/lead_reactivation_hot.csv
outputs/lead_reactivation_warm.csv
outputs/lead_reactivation_career_site.csv
outputs/lead_reactivation_ignore.csv
outputs/follow_up_due.csv
outputs/warm_leads.csv
outputs/dormant_leads.csv
outputs/rejected_or_closed_leads.csv
outputs/no_response_leads.csv
outputs/message_review_queue.csv
outputs/conversation_state_review_queue.csv

# ─── Untapped Network Intelligence — private person-level backlog ────────────
# Up to ~10k-contact operational CSVs (full names, companies, LinkedIn URLs).
# Only a small sanitized top-N slice goes into the public dashboard JSON via
# export_public_dashboard_data.py — the full backlog stays local.
outputs/private/
outputs/untapped_ambiguous_review.csv

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── Temporary files ─────────────────────────────────────────────────────────
*.tmp
*.bak
*.orig
~$*
